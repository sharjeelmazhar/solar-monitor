#!/bin/sh
# Blocks a commit if it contains secrets or breaks the fast tests.
# Enabled with: git config core.hooksPath .githooks
if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(git rev-parse --show-toplevel)/scripts/precommit.ps1"
fi
# Linux / macOS (the secrets job in CI scans every push too)
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v gitleaks >/dev/null 2>&1; then gitleaks git --staged --no-banner --redact || exit 1
else echo "pre-commit: gitleaks not installed, skipping the local secret scan"; fi
(cd web && npx vitest run --silent) || exit 1
